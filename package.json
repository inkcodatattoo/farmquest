{
  "name": "farmquest",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:structure": "node scripts/check-structure.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:validate": "pnpm --filter @farmquest/database prisma:validate",
    "db:generate": "pnpm --filter @farmquest/database prisma:generate",
    "openapi:generate": "pnpm --filter @farmquest/contracts openapi:generate"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
